# Copy this file to .env; replace all values before first use.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_16PLUS_CHARACTER_PASSWORD
BOOTSTRAP_ADMIN_NAME=Platform Owner
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Long random secret used only by the central API to sign school-install invitations.
INVITATION_SIGNING_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_FROM_EMAIL=EduCraft360 <onboarding@your-verified-domain.com>
